# Godot 4
.godot/
/android/

# Sibling repositories, linked for local development:
#   ln -s ../../<repo>/addons/<addon> addons/<addon>
# Consumers copy every one of them into their own project.
/addons/gs_core
/addons/gs_player
/addons/gs_animation
# gs-sim, for the ragdoll's native pose (examples/ragdoll_pose_native_checks.gd).
/addons/gs_sim

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/

# Contact sheets (tools/people_sheet.gd)
screenshots/
/addons/gs_combat

# Render output of tools/ scripts, for looking at.
/out/
/addons/gs_weapon

# Sibling addons linked for local suites (absolute links must never be tracked; CI resolves them from addons.lock):
/addons/godot-sqlite
/addons/gs_bot
/addons/gs_bot_record
/addons/gs_net
/addons/gs_profile
/addons/gs_sql
